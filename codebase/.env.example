# Không điền key thật vào file này. Copy thành .env.local rồi điền ở máy cá nhân.
GEMINI_API_KEY=

# Tuỳ chọn. Giá trị mặc định bám model stable hiện hành.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_RESOLVER_MODEL=gemini-3.1-flash-lite

# Đặt demo để buộc chạy lexical/mock dù máy có key.
# RESOLVER_MODE=demo
